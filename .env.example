# Copy to .env and fill in. Never commit .env.

# Port netdoc listens on (host networking, so this is a real host port)
NETDOC_PORT=8000

# Poll interval for connectors, in seconds
NETDOC_POLL_INTERVAL_SECONDS=300

# Optional: pin the Fernet encryption key instead of letting netdoc generate and
# persist one at /data/master.key. If set, back it up - losing it makes stored
# credentials unrecoverable. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
NETDOC_MASTER_KEY=

# Optional: pin the bearer token for the /mcp endpoint instead of the generated
# one at /data/mcp_token.
NETDOC_MCP_TOKEN=
